# 服务器配置
# 时区配置
TZ=Asia/Shanghai
SERVER_DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=15231
SERVER_WORKERS=1
API_KEY=test_api_key
EXPOSE_PORT=25231

# 构建加速配置（仅 docker build 时生效，不影响运行时）
# APT 镜像源域名：默认 deb.debian.org；国内环境推荐 mirrors.tuna.tsinghua.edu.cn / mirrors.aliyun.com
APT_MIRROR=deb.debian.org
# PyPI 镜像源：默认 https://pypi.org/simple；国内环境推荐 https://pypi.tuna.tsinghua.edu.cn/simple
UV_INDEX_URL=https://pypi.org/simple

# TTS 配置
TTS_ENGINE=chattts
TTS_LANGUAGE=zh

# CosyVoice 2 配置（Apache 2.0 可商用，本地离线 TTS 引擎）
# 安装与模型下载见 MODEL_DOWNLOAD.md §CosyVoice 2 模型下载
# COSYVOICE_MODEL_DIR: CosyVoice2-0.5B 模型目录（ModelScope 下载时点号→___；容器内用 /app/.cache 前缀）
# COSYVOICE_ROOT: CosyVoice 仓库根（无 setup.py，运行时靠 sys.path 导入）
# COSYVOICE_FP16: GPU 时设 1 启用 FP16 加速（约 6-8GB 显存；CPU 保持 0）
COSYVOICE_MODEL_DIR=./docker-deploy/.cache/cosyvoice-ms/iic/CosyVoice2-0___5B
COSYVOICE_ROOT=./docker-deploy/.cache/CosyVoice
COSYVOICE_FP16=0

# ASR 配置
ASR_ENGINE=qwen-asr
ASR_MODEL=medium
ASR_LANGUAGE=zh

# 流式 ASR 配置
# 引擎类型：funasr-server（代理外部 FunASR 服务）/ funasr-local（进程内 Paraformer 流式）/ sensevoice-local（进程内 SenseVoice + VAD）
STREAMING_ASR_ENGINE=funasr-local
# FunASR 流式模型（使用官方简写别名：paraformer-zh-streaming/fsmn-vad/ct-punc）
STREAMING_ASR_MODEL=paraformer-zh-streaming
# 2pass 离线精确模型：FINAL 阶段对整段音频重新识别，纠正流式阶段的同音字错误，并输出字级时间戳
STREAMING_OFFLINE_MODEL=paraformer-zh
# VAD 模型（用于端点检测）
STREAMING_VAD_MODEL=fsmn-vad
# 标点恢复模型
STREAMING_PUNC_MODEL=ct-punc
# SenseVoice 模型（当引擎为 sensevoice-local 时使用）
STREAMING_SENSEVOICE_MODEL=iic/SenseVoiceSmall
# 是否启用标点恢复
STREAMING_ENABLE_PUNC=True
# 音频分块毫秒数
STREAMING_CHUNK_MS=600
# 外部 FunASR serve_realtime_ws.py 服务地址（仅 funasr-server 引擎需要，示例格式 ws://host:port）
# 注意：请勿硬编码，通过环境变量配置
STREAMING_FUNASR_SERVER_URL=

# 通用模型配置
DEVICE=cpu
COMPUTE_TYPE=int8
MODEL_KEEP_ALIVE=5m
NUM_WORKERS=4

# 缓存配置
CACHE_DIR=./docker-deploy/.cache
LOCAL_FILES_ONLY=False
# 阿里 ModelScope 端点（推荐国内使用）
HF_ENDPOINT=https://www.modelscope.cn
# 备选端点
# HF_ENDPOINT=https://huggingface.co

# VL 模型配置
VL_MODEL=medium
VL_FRAME_INTERVAL=10
# 可用的 VL 模型地址（自动尝试）:
# - Qwen/Qwen3-VL-4B-Instruct (主地址)
# - qwen/Qwen3-VL-4B-Instruct (小写)
# - alibaba-pai/Qwen3-VL-4B-Instruct (阿里PAI)
# - modelscope/qwen/Qwen3-VL-4B-Instruct (ModelScope)