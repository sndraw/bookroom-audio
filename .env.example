# 服务器配置
# 时区配置
TZ=Asia/Shanghai
SERVER_DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=15231
SERVER_WORKERS=1
API_KEY=test_api_key
EXPOSE_PORT=25231

# TTS 配置
TTS_ENGINE=chattts
TTS_LANGUAGE=zh

# ASR 配置
ASR_ENGINE=qwen-asr
ASR_MODEL=medium
ASR_LANGUAGE=zh

# 通用模型配置
DEVICE=cpu
COMPUTE_TYPE=int8
MODEL_KEEP_ALIVE=5m
NUM_WORKERS=4

# 缓存配置
CACHE_DIR=./.cache
LOCAL_FILES_ONLY=False
# 阿里 ModelScope 端点（推荐国内使用）
HF_ENDPOINT=https://www.modelscope.cn
# 备选端点
# HF_ENDPOINT=https://hf-mirror.com
# HF_ENDPOINT=https://huggingface.co

# VL 模型配置
VL_MODEL=medium
VL_FRAME_INTERVAL=10
# 可用的 VL 模型地址（自动尝试）:
# - Qwen/Qwen3-VL-4B-Instruct (主地址)
# - qwen/Qwen3-VL-4B-Instruct (小写)
# - alibaba-pai/Qwen3-VL-4B-Instruct (阿里PAI)
# - modelscope/qwen/Qwen3-VL-4B-Instruct (ModelScope)